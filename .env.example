# ============================================================
# MnVision 360 — Environment Variables Template
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production
JWT_SECRET=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ------------------------------------------------------------
DATABASE_URL=postgresql://mnvision:mnvision360@postgres:5432/mnvision360
POSTGRES_DB=mnvision360
POSTGRES_USER=mnvision
POSTGRES_PASSWORD=mnvision360
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------
# MinIO Object Storage
# ------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mnvision_access
MINIO_SECRET_KEY=mnvision_secret_key
MINIO_BUCKET_SATELLITE=satellite-data
MINIO_BUCKET_MODELS=ml-models
MINIO_BUCKET_RESULTS=prediction-results
# Set to true when using HTTPS in production
MINIO_SECURE=false

# ------------------------------------------------------------
# MLflow Experiment Tracking
# ------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=mnvision360
# Optional: S3/MinIO artifact store for MLflow
# MLFLOW_S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=mnvision_access
# AWS_SECRET_ACCESS_KEY=mnvision_secret_key

# ------------------------------------------------------------
# Google Earth Engine (Phase 5 — leave blank until needed)
# ------------------------------------------------------------
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
GEE_PROJECT=

# ------------------------------------------------------------
# Frontend (Vite build-time variables)
# ------------------------------------------------------------
VITE_API_URL=http://localhost/api
VITE_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json
# Optional: set a self-hosted MapTiler/MapLibre tile URL
# VITE_MAPTILER_KEY=

# ------------------------------------------------------------
# PgAdmin (Database Administration UI)
# ------------------------------------------------------------
PGADMIN_EMAIL=admin@mnvision.local
PGADMIN_PASSWORD=admin360

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------
# CORS (comma-separated origins for the backend)
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
# Enable/disable ML inference endpoint
FEATURE_ML_INFERENCE=true
# Enable/disable GEE integration (Phase 5+)
FEATURE_GEE=false
# Show prototype/synthetic data warnings in UI
SHOW_PROTOTYPE_WARNINGS=true
