# ------------------------------------------------------------
# Data Directories (selective — keep synthetic & boundaries)
# ------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
!data/raw/boundaries/
!data/raw/boundaries/**

data/processed/*
!data/processed/.gitkeep

data/features/*
!data/features/.gitkeep

data/models/*
!data/models/.gitkeep

data/predictions/*
!data/predictions/.gitkeep

# KEEP: synthetic data is version-controlled (it's generated, not real)
# data/synthetic/ is intentionally NOT listed here

